{
  "name": "papi-industries-green-shift",
  "version": "0.1.0",
  "description": "PAPI Industries: The Green Shift — a Phaser 4 industrial survival tower defense game.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "cd tests/unit && node --test",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:full": "npm run test && npm run test:e2e",
    "test:soak": "node --expose-gc tests/soak/domain.soak.js",
    "test:soak:browser": "playwright test --config playwright.soak.config.js"
  },
  "dependencies": {
    "phaser": "^4.0.0"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "@playwright/test": "^1.47.0"
  }
}
